<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The Aspire.AppHost.Sdk injects RID-specific orchestration/dashboard packages that
         don't fit central package management, so manage this project's versions locally. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Those injected packages are RID-specific, so a committed lock file would be
         win-x64/linux-x64 dependent and break CI's locked-mode restore across OSes. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <UserSecretsId>urlshortener-apphost</UserSecretsId>
    <!-- Aspire 13.5 warns when the CLI bundle is absent; this host is dev-only orchestration. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.1" />
    <PackageReference Include="AndreGoepel.AppFoundation.Aspire" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndreGoepel.UrlShortener\AndreGoepel.UrlShortener.csproj" />
  </ItemGroup>
</Project>
