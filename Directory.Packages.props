<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="AndreGoepel">
    <PackageVersion Include="AndreGoepel.AppFoundation" Version="2.1.1" />
    <PackageVersion Include="AndreGoepel.AppFoundation.Hosting" Version="2.1.1" />
    <PackageVersion Include="AndreGoepel.Marten.Identity.Blazor" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />
  </ItemGroup>

  <ItemGroup Label="Libraries">
    <PackageVersion Include="Marten" Version="9.33.0" />
    <PackageVersion Include="Radzen.Blazor" Version="11.3.2" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion
      Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets"
      Version="1.23.0"
    />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.2.3" />
    <PackageVersion Include="AndreGoepel.Testing.E2E" Version="1.3.2" />
    <PackageVersion Include="AngleSharp" Version="1.8.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>
