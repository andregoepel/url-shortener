<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="AndreGoepel">
    <PackageVersion Include="AndreGoepel.AppFoundation" Version="2.0.0" />
    <PackageVersion Include="AndreGoepel.AppFoundation.Hosting" Version="2.0.0" />
    <PackageVersion Include="AndreGoepel.Marten.Identity.Blazor" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.1" />
  </ItemGroup>

  <ItemGroup Label="Libraries">
    <PackageVersion Include="Marten" Version="9.29.0" />
    <PackageVersion Include="Radzen.Blazor" Version="11.2.6" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion
      Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets"
      Version="1.23.0"
    />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.1.0" />
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>
