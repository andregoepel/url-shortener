<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="AndreGoepel">
    <PackageVersion Include="AndreGoepel.Design.Blazor" Version="1.7.2" />
    <PackageVersion Include="AndreGoepel.AppFoundation" Version="2.3.1" />
    <PackageVersion Include="AndreGoepel.AppFoundation.Hosting" Version="2.3.1" />
    <PackageVersion Include="AndreGoepel.Marten.Identity.Blazor" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup Label="Libraries">
    <PackageVersion Include="Marten" Version="9.50.3" />
    <PackageVersion Include="Radzen.Blazor" Version="12.1.4" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <!-- Patch the transitive PKCS dependency for GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion
      Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets"
      Version="1.23.0"
    />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.2.7" />
    <PackageVersion Include="AndreGoepel.Testing.E2E" Version="1.3.5" />
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
